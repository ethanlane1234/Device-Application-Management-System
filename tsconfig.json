{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "module": "commonjs",
    "strict": true,
    "noImplicitAny": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "sourceMap": true,
    "allowJs": true,
    "outDir": "./compiled",
    "esModuleInterop": true,
  },
  "files": [
    "app.ts",
    "client.js",
    "server.js"
  ]
}